            "text": "{\"data\":{\"id\":\"7274c987-2c91-43bd-a7f5-da3e8b98a3a7\",\"parent_id\":\"cc9e3a09-49d1-4608-ba7e-6ece3d8d577c\",\"title\":\"12. 부상\",\"description\":\"마이클은 조지 포먼 그릴에 묘한 사고를 당하고, 드와이트는 경미한 자동차 접촉사고 이후 이상하게 행동한다.\",\"short_description\":\"마이클은 조지 포먼 그릴에 묘한 사고를 당하고, 드와이트는 경미한 자동차 접촉사고 이후 이상하게 행동한다.\",\"as\":\"EPISODE\",\"region\":\"KR\",\"languages\":[\"영어\",\"한국어\"],\"audios\":[\"영어\"],\"age_rating\":\"15+\",\"age_rating_localized\":\"15+\",\"is_rating_category_exempted\":false,\"streamable\":true,\"downloadable\":true,\"running_time\":1272,\"images\":{\"story-art\":{\"id\":\"398f6935-4bf5-497f-ad1d-4a0f369b0ff9\",\"md5\":null,\"url\":\"https://img.coupangstreaming.com/titles/7274c987-2c91-43bd-a7f5-da3e8b98a3a7/story-art/08b0abd3-9ed3-4f2e-abe1-16150466641a.png\",\"tags\":\"\",\"index\":null,\"default\":false,\"language\":\"ko\",\"title_id\":\"7274c987-2c91-43bd-a7f5-da3e8b98a3a7\",\"created_at\":\"2022-11-23T15:26:21.613+00:00\",\"updated_at\":\"2023-11-29T07:34:59.824+00:00\"}},\"tags\":[{\"tag\":\"시트콤\",\"meta\":{\"genre\":true},\"label\":\"시트콤\",\"language\":\"ko\",\"id\":\"73ca8765-1a1a-4533-9dc4-996921b12574\"},{\"tag\":\"drama\",\"meta\":{\"genre\":true},\"label\":\"드라마\",\"language\":\"ko\",\"id\":\"d9799519-017d-4fad-8163-9734720a87a1\"},{\"tag\":\"코미디\",\"meta\":{\"genre\":true},\"label\":\"코미디\",\"language\":\"ko\",\"id\":\"14f25e3a-d954-484c-bce2-05f05f4b74ad\"}],\"people\":[{\"name\":\"스티브 카렐\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"레인 윌슨\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"존 크래신스키\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"제나 피셔\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"비제이 노박\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"브라이언 바움가트너\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"켄 콰피스\",\"role\":\"DIRECTOR\",\"language\":\"ko\"}],\"meta\":{\"awards\":[],\"copyright\":\"© 2005 NBC Studios, Inc. and Universal Network Television LLC. All Rights Reserved.\",\"releaseYear\"