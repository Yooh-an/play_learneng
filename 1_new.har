//couplay-groupwatch-prod-7.asia-southeast1.firebasedatabase.app\",\"https://couplay-groupwatch-prod-8.asia-southeast1.firebasedatabase.app\",\"https://couplay-groupwatch-prod-9.asia-southeast1.firebasedatabase.app\",\"https://couplay-groupwatch-prod-10.asia-southeast1.firebasedatabase.app\"]},\"group_watch_feed_refresh_interval\":20,\"player_preroll_enabled\":\"true\",\"player_preroll_url\":\"https://img.coupangstreaming.com/backstage/preroll/Coupang-preroll-v5.mp4\",\"player_preroll_kids_url\":\"https://img.coupangstreaming.com/backstage/preroll/Coupang-preroll-v5.mp4\",\"web_enable_wow_price_increase\":false,\"web_enable_token_cookie_expiry_refresh\":true,\"web_session_expiry_in_seconds\":15552000,\"web_remote_config_session_expiry_percentage\":100},\"pageProps\":{\"_nextI18Next\":{\"initialI18nStore\":{\"ko\":{\"common\":{\"404_error\":\"서비스 이용에 불편을 드려 죄송합니다. 해당 페이지를 찾을 수 없습니다. 홈페이지로 이동해 다양한 콘텐츠를 만나보세요.\",\"500_error\":\"서비스 이용에 불편을 드려 죄송합니다. 일시적인 오류가 발생했습니다. 잠시 후 다시 시도해주세요.\",\"CTA_schedule_empty_state\":\"다른 경기 보기\",\"CTA_sports_alarm_popup\":\"푸시 알림 받기\",\"CTA_webview_tv\":\"돌아가기\",\"Date_today_sports_schedule\":\"오늘\",\"Date_tomorrow_sports_schedule\":\"내일\",\"Date_yesterday_sports_schedule\":\"어제\",\"Header_sports_schedule\":\"추천 경기\",\"SecondaryCTA_sports_alarm_popup\":\"나중에 설정하기\",\"SecondaryCTA_sports_schedule\":\"경기 더 보기\",\"TV_app_guide_androidtv\":\"안드로이드 TV, 딜라이브, CMB, 샤오미, 호매틱스\",\"TV_app_guide_appletv\":\"애플 TV\",\"TV_app_guide_appletv_instruction1\":\"홈 화면에서 ‘앱 스토어' 클릭\",\"TV_app_guide_cs\":\"*쿠팡플레이 TV앱 설치 및 접속에 문제가 있는 경우 고객센터(1600-9800)로 문의 바랍니다.\",\"TV_app_guide_disclaimer\":\"서비스 제공사 및 디바이스 모델에 따라 예시 이미지와 차이가 있을 수 있습니다.\",\"TV_app_guide_instruction1\":\"[[deviceName]] 리모컨 '홈' [[HomeIcon]] 선택\",\"TV_app_guide_instruction2\":\"우측 상단 ‘검색’ [[SearchIcon]] 선택 후 “쿠팡플레이” 검색 후 설치\",\"TV_app_guide_instruction3\":\"archive\",\"TV_app_guide_instruction4\":\"\\\"쿠팡플레이\\\" 검색 후 설치\",\"TV_app_guide_ktgigagenie\":\"KT 기가지니\",\"TV_app_guide_ktgigagenie_instruction1\":\"상단 메뉴 바 ‘지니APPs’ 이동 후, 'Google Play 스토어' 선택\",\"TV_app_guide_lgtv\":\"LG 스마트 TV\",\"TV_app_guide_lgtv_header2\":\"*이 가이드는 2017- 2022 기기에서만 적용됩니다\",\"TV_app_guide_lgtv_instruction1\":\"화면 하단에서 '쿠팡플레이' 클릭, \\\\n 안 보일 경우, 'LG 콘텐츠 스토어' 선택\",\"TV_app_guide_lgtv_remote\":\"LG TV 리모컨 '홈' 선택 \\\\n (2022 이후 버전에서는 LG TV 리모컨 ‘쿠팡플레이' 선택)\",\"TV_app_guide_lgu+\":\"LG유플러스(U+) TV\",\"TV_app_guide_playstore\":\"‘Google Play 스토어’ 선택\",\"TV_app_guide_previous_step_not_found\":\"이전 단계에서 '쿠팡플레이'가 안 보일 시\",\"TV_app_guide_samsungtv\":\"삼성 스마트 TV\",\"TV_app_guide_samsungtv_header2\":\"*이 가이드는 2020- 2023 기기에서만 적용됩니다\",\"TV_app_guide_samsungtv_instruction1\":\"화면 하단에서 '쿠팡플레이' 클릭, \\\\n 안 보일 경우, 'Apps/앱스' 선택\",\"TV_app_guide_skbtv\":\"SK Btv\",\"TV_app_guide_skylife\":\"KT 스카이라이프 셋톱박스\",\"TV_app_guide_skylife_instruction1\":\"화면 좌측 메뉴 바 ‘웨이브,왓챠’ 선택 후, \\\\n 최상단 레일 끝에서 '쿠팡플레이' 선택\",\"TV_app_guide_skylife_instruction2\":\"최상단 레일 끝에서 '쿠팡플레이' 선택\",\"TV_app_guide_u+_instruction1\":\"메뉴에서 ‘TV앱스’ 선택 후, '모든 앱' 선택\",\"TV_app_guide_warning\":\"해외 직구 TV는 쿠팡플레이가 지원되지 않습니다\",\"TV_app_guide_webview_description\":\"사용하시는 기기를 선택하여 TV앱 설치 방법을 확인하세요.\",\"TV_app_guide_webview_subheader\":\"쿠팡플레이를 큰 화면으로 즐기세요!\",\"TV_channel_subscription_complete\":\"TV 앱에서 확인을 누르시고 시청하세요\",\"TV_channel_subscription_qr_guide\":\"휴대폰 카메라로 QR 코드를 스캔하여\\\\n가입 화면으로 이동해주세요\",\"Toaster_optin_sports_schedule\":\"생방송 경기가 시작되면 알려드리겠습니다!\",\"Toaster_optout_sports_schedule\":\"경기 알람이 꺼졌습니다\",\"VS_match_info_edp\":\"VS\",\"age_bcast_date_broadcast\":\"방송일자:\",\"age_bcast_station_name\":\"방송사명:\",\"age_rating_12_bcast_desc\":\"이 콘텐츠는 만 12 세 이상은 누구나 시청할 수 있습니다.\",\"age_rating_12_desc\":\"이 콘텐츠는 만 12 세 이상은 누구나 시청할 수 있습니다.\",\"age_rating_15_bcast_desc\":\"이 콘텐츠는 만 15 세 이상은 누구나 시청할 수 있습니다.\",\"age_rating_15_desc\":\"이 콘텐츠는 만 15 세 이상은 누구나 시청할 수 있습니다.\",\"age_rating_18_desc\":\"이 콘텐츠는 청소년관람불가 등급으로 19세 미만의 청소년은 시청할 수 없습니다.\",\"age_rating_19_bcast_desc\":\"이 콘텐츠는 청소년관람불가 등급으로 19세 미만의 청소년은 시청할 수 없습니다.\",\"age_rating_19_desc\":\"이 콘텐츠는 청소년관람불가 등급으로 19세 미만의 청소년은 시청할 수 없습니다.\",\"age_rating_7_bcast_desc\":\"이 콘텐츠는 만 7 세 이상은 누구나 시청할 수 있습니다.\",\"age_rating_7_desc\":\"이 콘텐츠는 7 세 미만 청소년은 시청할 수 없습니다\",\"age_rating_R_desc\":\"본 영상물은 상영에 제한이 필요합니다.\",\"age_rating_all_bcast_desc\":\"이 콘텐츠는 모든 연령이 시청할 수 있습니다.\",\"age_rating_all_desc\":\"이 콘텐츠는 모든 연령이 시청할 수 있습니다\",\"age_rating_badge_12\":\"12+\",\"age_rating_badge_15\":\"15+\",\"age_rating_badge_18\":\"18+\",\"age_rating_badge_19\":\"19+\",\"age_rating_badge_7\":\"7+\",\"age_rating_badge_all\":\"ALL\",\"age_rating_classification_num\":\"등급분류번호:\",\"age_rating_restricted_desc\":\"본 영상물은 상영에 제한이 필요합니다.\",\"age_trade_name\":\"콘텐츠 제공사:\",\"agree_tnc_failed_content\":\"오류가 발생했습니다. 다시 시도해 주세요\",\"agree_tnc_failed_title\":\"다시 시도해 주세요\",\"air_clearances_match_info_edp\":\"Aerial Duels\",\"alert_line_up_edp\":\"포메이션은 전반전 킥오프\\\\n기준으로 노출됩니다\",\"alert_signIn_message\":\"아직 쿠팡 와우 회원이 아니신가요?\\\\n와우 멤버십에 가입하시면 쿠팡플레이를 이용하실 수 있습니다.\\\\n\\\\n와우 멤버십에 가입되어 있는 ID로 로그인 하시면 바로 이용 가능합니다.\",\"alert_signIn_message_wow_only\":\"아직 쿠팡 와우회원이 아니신가요?\\\\n와우 멤버십에 가입하시면 쿠팡플레이를\\\\n무료로 시청할 수 있습니다.\",\"alert_signIn_title\":\"쿠팡플레이에 로그인하지 못했습니다\",\"alert_signIn_title_invalid_credentials\":\"입력하신 아이디(이메일) 혹은 비밀번호를 다시 확인해주세요\",\"alert_signIn_title_no_account\":\"아직 쿠팡 와우 회원이 아니신가요?\\\\n와우 멤버십에 가입하시면 쿠팡플레이를 이용하실 수 있습니다.\\\\n\\\\n와우 멤버십에 가입되어 있는 ID로 로그인 하시면 바로 이용 가능합니다.\",\"alert_signIn_title_non_wowmember\":\"아직 쿠팡 와우 회원이 아니신가요?\\\\n와우 멤버십에 가입하시면 쿠팡플레이를 이용하실 수 있습니다.\\\\n\\\\n와우 멤버십에 가입되어 있는 ID로 로그인 하시면 바로 이용 가능합니다.\",\"alert_signIn_title_wow_only\":\"쿠팡플레이는\\\\n와우회원만 시청할 수 있습니다.\",\"alert_signIn_title_wow_only_details1_first_line\":\"쿠팡 와우 멤버십에 가입하고\",\"alert_signIn_title_wow_only_details1_second_line\":\"쿠팡플레이의 다양한 콘텐츠를 즐겨보세요\",\"alert_signIn_title_wow_only_details1_signup_link_text_above_CTA\":\"아래 링크로 와우 멤버십 가입하기\",\"alert_signIn_title_wow_only_header1\":\"와우 회원만 사용할수 있습니다\",\"android_tv_empty_highlights\":\"아직 하이라이트가 없습니다\",\"api_calling_fail_body_refresh\":\"요청을 완료하지 못했습니다. 화면을 새로 고치거나 앱으로 돌아가 가입 옵션을 다시 선택해 주세요.\",\"api_calling_fail_body_return\":\"모바일 앱으로 돌아가서 가입 옵션을 다시 선택하세요. 잘못된 계정에 로그인한 경우 로그아웃했다가 다시 로그인하세요.\",\"app_name\":\"쿠팡플레이\",\"app_name_full_description\":\"최신 영화, TV 시리즈, 스포츠 중계, 독점 쿠플 시리즈까지 모두 한 곳에서 마음껏 즐기세요\",\"app_name_full_title\":\"쿠팡플레이\",\"app_push_notification_in_player_description\":\"다른 페이지로 이동하게 됩니다.\",\"app_push_notification_in_player_title\":\"시청하던 영상을 종료할까요?\",\"app_push_notification_night_text\":\"오후 9시 이후 알림\",\"app_push_notification_text\":\"푸시 알림\",\"app_push_notifications_noaccess_message\":\"알림을 활성화하려면 설정 \\u003e 알림 \\u003e 쿠팡플레이를 누르세요.\",\"app_push_notifications_noaccess_title\":\"{{0}}  알림에 액세스할 수 없습니다.\",\"apple_tv_landing_fallback\":\"애플 TV에 곧 출시됩니다!\",\"auth_error_enter_email_and_password\":\"이메일과 비밀번호를 모두 입력해주세요.\",\"auth_error_invalid_email_password\":\"이메일 또는 비밀번호가 유효하지 않습니다. 다시 확인해주세요.\",\"auth_error_not_wow_member\":\"와우 멤버십에 가입되어 있는 ID로 로그인해주세요.\",\"auth_error_too_many_attempts\":\"아이디 및 비밀번호 입력 오류 횟수를 초과했습니다.\\\\n10분 후 다시 시도해주세요.\",\"away_team_edp\":\"원정 팀명\",\"away_team_past_matches_edp\":\"원정팀명\",\"b2b_account_login_error_message\":\"쿠팡플레이는 개인 회원 전용 서비스입니다. \\\\n개인 계정으로 로그인해주세요. \",\"b2b_account_login_error_message_pcweb\":\"쿠팡플레이는 개인 회원 전용 서비스입니다. 개인 계정으로 로그인해주세요. \",\"badge_buy\":\"개별구매\",\"badge_closed\":\"마감\",\"badge_couplay\":\"쿠플\",\"badge_highlights\":\"하이라이트\",\"badge_live\":\"생중계\",\"badge_new\":\"신규\",\"badge_new_ep\":\"업데이트\",\"badge_new_episode\":\"신규 에피소드\",\"badge_open\":\"집계 중\",\"badge_recent_game_lose_match_info_edp\":\"패\",\"badge_recent_game_tie_match_info_edp\":\"무\",\"badge_recent_game_win_match_info_edp\":\"승\",\"badge_series\":\"시리즈\",\"badge_tvshow_live\":\"생방송\",\"badge_upcoming_live\":\"예정\",\"badge_upcoming_vod\":\"공개예정\",\"badge_weekly\":\"매주\",\"banner_ended\":\"종료\",\"banner_highlights\":\"하이라이트\",\"banner_kids_content\":\"자녀 보호 시청, 키즈프로필로\",\"banner_kids_content_1\":\"자녀 보호 시청\",\"banner_kids_content_2\":\"키즈프로필로\",\"banner_new\":\"신규\",\"banner_upcoming\":\"예정\",\"bluebird_2024_authentication_bodytext_1\":\"로그인 된\",\"bluebird_2024_authentication_bodytext_2\":\"와우회원 본인의 이름\",\"bluebird_2024_authentication_bodytext_3\":\"으로만 티켓 구매가 가능합니다.\",\"bluebird_2024_authentication_bodytext_4\":\"이름을 확인하고 티켓 구매를 시작해 보세요!\",\"bluebird_2024_authentication_btn\":\"이름 확인 및 구매 시작\",\"bluebird_2024_authentication_name\":\"이름\",\"bluebird_2024_authentication_subtitle\":\"Presented by Coupang Play\",\"bluebird_2024_authentication_title\":\"2024 쿠팡플레이 시리즈\",\"bluebird_2024_bottomsheet_cta\":\"경기 선택 완료\",\"bluebird_2024_complete_purchase\":\"티켓 구매를 완료했습니다!\",\"bluebird_2024_location\":\"서울월드컵경기장\",\"bluebird_2024_location_title\":\"경기장소\",\"bluebird_2024_noti_text_1\":\"티켓 예매 오픈 알림 받기\",\"bluebird_2024_noti_text_2\":\"티켓 예매 오픈 알림 설정 완료\",\"bluebird_2024_ticketingdate\":\"6월 28일 (금) 저녁 7시\",\"bluebird_2024_ticketingdate_title\":\"티켓 오픈일정\",\"bluebird_cancel_purchase_dialog_cta_1\":\"계속 진행하기\",\"bluebird_cancel_purchase_dialog_cta_2\":\"그만하기\",\"bluebird_cancel_purchase_dialog_msg\":\"지금까지 입력된 정보는 저장되지 않습니다.\",\"bluebird_cancel_purchase_dialog_title\":\"티켓 구매를 그만하시겠습니까?\",\"bluebird_error_message_dl1011\":\"구매/환불이 완료됐습니다. \\\\n[[프로필 \\u003e 구매내역]]에서 자세한 내용을 확인해보세요.\\\\n(DI-1011)\",\"bluebird_game_selection_after\":\"잔여 티켓 확인하기\",\"bluebird_game_selection_before\":\"{{0}} 티켓 판매 시작\",\"bluebird_game_selection_during\":\"예매하기\",\"bluebird_match_selection_cta\":\"경기 선택하기\",\"bluebird_match_selection_header\":\"경기 선택\",\"bluebird_microsite_completed\":\"내 구매내역에서 티켓정보를 확인하고, 경기 3일전부터 티켓 발권이 가능합니다.\",\"bluebird_microsite_completed_cta\":\"내 구매내역 보기\",\"bluebird_my_purchase_download_cta\":\"스마트 티켓 디운로드 받기\",\"bluebird_my_purchase_issue_cta\":\"스마트 티켓 발권 받기\",\"bluebird_my_purchase_list_match_date\":\"관람일시 {{0}}\",\"bluebird_my_purchase_list_purchase_date\":\"{{0}}에 구매\",\"bluebird_my_purchase_smart_ticket_cta\":\"스마트 티켓 확인하기\",\"bluebird_my_purchase_tab_movies\":\"영화\",\"bluebird_my_purchase_tab_tickets\":\"티켓\",\"bluebird_my_purchase_tooltip\":\"구매한 티켓의 내역은 이 탭에서 확인할 수 있습니다\",\"bluebird_queue_alt_body\":\"현재 접속량이 많아 연결이 지연되고 있습니다.\\\\n서비스 이용에 불편을 드려 죄송합니다.\\\\n\\\\n잠시만 기다리시면 예매 페이지로 이동합니다.\\\\n대기자가 많을 경우 대기열로 진입하게 됩니다.\",\"bluebird_queue_alt_header\":\"티켓 예매 접속 대기 중입니다\",\"bluebird_queue_body\":\"잠시만 기다리시면 티켓 예매 페이지로 이동합니다.\\\\n대기자가 많을 경우 대기열로 진입하게 됩니다.\",\"bluebird_queue_header\":\"티켓 예매를 위해 이동 중입니다\",\"bluebird_ticket_details_cancellation\":\"취소기한 {{0}}\",\"bluebird_ticket_details_cta\":\"전체 티켓 정보 보기\",\"bluebird_ticket_details_no_of_tickets\":\"티켓 {{0}}개\",\"bluebird_tooltip_my_download\":\"다운로드 받은 티켓이 있으시네요!\\\\n티켓은 다운로드 탭에서 확인하세요\",\"bluebird_tooltip_my_purchase\":\"구매하신 티켓이 있으시네요.\\\\n티켓은 구매내역에서 확인하세요.\",\"body1_webview_closed\":\"대국민 응원 투표가 종료되었습니다. 감사합니다.\",\"body2_webview_closed\":\"대국민 응원 투표가 종료되었습니다. 감사합니다.\",\"body_duringvote_popover_play\":\"응원하는 가수의 영상을 시청해주세요!\\\\n준결승・결승 영상 조회수는 최종 결과에 반영됩니다.\\\\n*정상적으로 시청되지 않은 조회수(매크로 등)는 제외\",\"body_livevote_popover_play\":\"생방송 말미에 투표 결과가 공개됩니다.\",\"body_prevote_popover_coupang\":\"본 투표는 인기투표이며 순위 결정에 반영되지 않습니다. 와우회원은 쿠팡플레이 앱에서 한번 더 투표할 수 있습니다\",\"body_prevote_popover_play\":\"본 투표는 인기투표이며 순위 결정에 반영되지 않습니다. \\\\n10/21 (목) 방송 이후 순위를 결정하는 대국민 응원 투표가 실시됩니다.\",\"body_webview_tv\":\"모바일 기기에서 쿠팡플레이 앱 또는 쿠팡 앱을 이용하여\\\\n응원하는 가수에게 투표하세요!\",\"body_webview_vote_popover_error\":\"세션이 만료되었습니다. 뒤로가기 후 다시 시도해주세요.\",\"body_webview_vote_popover_error1\":\"페이지 새로고침 후 다시 시도해주세요.\",\"btn_addProfile\":\"추가\",\"btn_back\":\"뒤로\",\"btn_buy_or_rent\":\"구매하기\",\"btn_cancel\":\"취소\",\"btn_close\":\"닫기\",\"btn_close_chat\":\"채팅 나가기\",\"btn_continue\":\"다음\",\"btn_deleteProfile\":\"프로필 삭제\",\"btn_get_started\":\"시작하기\",\"btn_label_delete\":\"삭제\",\"btn_manage\":\"관리하기\",\"btn_ok\":\"확인\",\"btn_onboarding_skip\":\"건너 뛰기\",\"btn_profile_update\":\"프로필 업데이트하기\",\"btn_save\":\"저장하기\",\"btn_signIn_WOW\":\"쿠팡앱으로 로그인하기\",\"btn_signOut\":\"로그아웃\",\"btn_signUp_WOW\":\"쿠팡 와우 멤버십 가입\",\"btn_sign_in\":\"쿠팡 아이디로 로그인하기\",\"button_all_genres\":\"모든 장르\",\"button_audio_subtitles\":\"음성 \\u0026 자막\",\"button_back_to_live\":\"라이브로 이동\",\"button_back_to_settings\":\"설정으로 돌아가기\",\"button_cancel\":\"취소\",\"button_chat\":\"채팅\",\"button_chat_off\":\"실시간 채팅 끔\",\"button_chat_on\":\"실시간 채팅 켬\",\"button_common_request\":\"\",\"button_confirm\":\"확인\",\"button_continue\":\"이어보기\",\"button_custom_episode_continue\":\"{{0}}: {{1}} 이어보기\",\"button_custom_episode_start\":\"시즌{{0}} {{1}}화 재생하기\",\"button_disconnect\":\"연결 해제하기\",\"button_done\":\"완료\",\"button_enable_access\":\"지금 바로 연결하기\",\"button_episode_continue\":\"시즌{{0}} {{1}}화 이어보기\",\"button_episodes\":\"에피소드 목록\",\"button_event_ended\":\"생중계 종료\",\"button_feedback\":\"의견 보내기\",\"button_go\":\"GO!\",\"button_go_back\":\"뒤로가기\",\"button_lock\":\"화면 잠금\",\"button_login\":\"로그인\",\"button_more_details\":\"상세 정보 보기\",\"button_next_episode\":\"다음화\",\"button_no_thanks_notification\":\"푸시 알림 끄기\",\"button_profile_management\":\"프로필 관리\",\"button_quality\":\"해상도\",\"button_refresh\":\"새로고침\",\"button_return_to_home\":\"홈 화면으로 돌아가기\",\"button_return_to_player\":\"계속 시청하기\",\"button_season_episodes\":\"회차 정보\",\"button_see_all\":\"전체보기\",\"button_see_less\":\"접기\",\"button_see_more\":\"더보기\",\"button_send_feedback\":\"의견 보내기\",\"button_start_watching\":\"재생하기\",\"button_starts_at\":\"에서 시작\",\"button_tap_to_unlock\":\"3 초간 눌러 화면 잠금을 해제하세요\",\"button_try_again\":\"다시 시도\",\"button_turn_on_notifications\":\"푸시 알림 받기\",\"button_upcoming_month_date\":\"M월 d일 (E) 공개예정\",\"button_view\":\"확인하기\",\"button_watch_again\":\"다시 보기\",\"button_watch_live_now\":\"생방송 재생하기\",\"button_watch_live_now_sports\":\"생중계 재생하기\",\"button_watch_now\":\"재생하기\",\"button_yes_exit\":\"네, 종료\",\"buttontext_alarm_off\":\"알림켜짐\",\"buttontext_alarm_on\":\"알림받기\",\"buttontext_alarm_turn_off\":\"알림끄기\",\"cancel_instant_module_body\":\"이 채널을 취소하시겠습니까?\\\\n취소시 채널 서비스는 즉시 종료됩니다.\",\"cancel_module_cta\":\"콘텐츠 보기\",\"cancel_module_header\":\"아직 시청하지 않은 다양한 프리미엄 콘텐츠가 있습니다!\",\"cancel_module_header_2\":\"가입을 해지하려는 이유를 알려주세요\",\"cancel_now_module_cta\":\"채널 가입 해지하기\",\"cancel_refund_module_cta\":\"가입 해지하고 환불 받기\",\"cancel_subscription_module_body\":\"이 채널의 가입을 해지하시겠습니까?\\\\n가입 해지 후 {{0}}까지 시청할 수 있습니다.\",\"cancel_within_7days_body\":\"이 채널의 가입을 해지하시겠습니까?\\\\n현재 청구 주기가 끝나면 가입이 해지됩니다. \",\"cast_allow_local_network_access_description\":\"TV에 연결하려면 쿠팡플레이를 네트워크에 연결해주세요\",\"cast_allow_local_network_access_title\":\"TV에서 영상을 시청하려면 네트워크에 연결해주세요\",\"cast_casting_to\":\"%1$s로 연결 중입니다\",\"cast_connecting\":\"%@로 연결 중입니다\",\"cast_connecting_to\":\"%1$s로 연결 중입니다\",\"cast_failed_try_again\":\"연결에 실패했습니다. 다시 시도해주세요.\",\"cast_getting_ready\":\"연결 준비 중\",\"cast_movie_subtitle\":\"영화\",\"cast_no_device_description\":\"스마트TV나 기기가 켜져있고 같은 WiFi 네트워크에 연결되어 있는지 확인해주세요\",\"cast_no_device_title\":\"발견된 기기가 없습니다\",\"cast_page_body\":\"TV앱으로 더 나은 쿠팡플레이를 경험하세요\",\"cast_page_cta\":\"TV앱 지원 기기 확인하기\",\"cast_page_device_body\":\"연결 대상 기기가 켜져있고 휴대 기기와 같은 Wi-Fi 네트워크에 \\\\n 연결되어있는지 확인하세요\",\"cast_page_device_not_found\":\"기기를 찾을 수 없습니다\",\"cast_page_device_searching\":\"연결 대상 검색 중\",\"cast_page_header\":\"연결 대상\",\"cast_ready_to_cast\":\"연결 준비 완료\",\"cast_ready_to_cast_to\":\"%1$s(으)로 연결되었습니다. 바로 시청하세요.\",\"cast_select_device\":\"연결한 기기를 선택해주세요\",\"cast_states_text_playing_on_device\":\"{{0}}에서 재생중입니다\",\"cast_volume\":\"음량\",\"casting_to\":\"%@로 연결 중입니다\",\"category_all_categories\":\"모든 카테고리\",\"category_all_sports\":\"모든 종목\",\"category_second_depth_nonwow_cta\":\"와우로 재생하기\",\"cdp_channel_subscription_cta_description\":\"{{0}} 무료체험 이후 결제\",\"cdp_channel_tab_subtext_free_trial\":\"{{1}}일동안 {{0}} 채널의 모든 콘텐츠를 무료로 체험해보세요\",\"cdp_channel_tab_subtext_subscribe\":\"{{0}} 채널에 가입하고 모든 콘텐츠를 무제한으로 시청하세요\",\"cdp_cta_0won_payment\":\"쿠플 특가로 시청하기\",\"cdp_more_info_age_rating\":\"연령 등급\",\"cdp_more_info_audio\":\"오디오\",\"cdp_more_info_cast\":\"출연진\",\"cdp_more_info_cast_header\":\"추가 정보\",\"cdp_more_info_composer\":\"작곡가\",\"cdp_more_info_hide\":\"숨기기\",\"cdp_more_info_producer\":\"제작자\",\"cdp_more_info_running_time\":\"재생시간\",\"cdp_more_info_see_more\":\"더 보기\",\"cdp_more_info_synopsis_header\":\"시놉시스\",\"cdp_svod_nonwow_cta\":\"와우 멤버십 가입하고 재생하기\",\"cdp_tab_channel\":\"채널\",\"cdp_tab_collection\":\"컬렉션\",\"cdp_tab_more_info\":\"상세정보\",\"cdp_tab_reco\":\"추천콘텐츠\",\"cdp_ticketing_nonwow_cta\":\"와우 멤버십 가입하고 티켓 구매하기\",\"cdp_tvod_coupon_text_button\":\"{{0}}₩ 할인쿠폰 적용하기\",\"cdp_tvod_nonwow_cta\":\"와우 멤버십 가입하고 구매하기\",\"change_lang_msg\":\"사용할 언어를 선택하세요\",\"change_lang_title\":\"언어 선택\",\"change_payment_method\":\"결제 수단 변경\",\"channel_CTA_freetrial\":\"무료 체험으로 시청\",\"channel_CTA_freetrial_page\":\"무료 체험으로 시작\",\"channel_CTA_no_freetrial\":\"{{0}} 채널 가입하기\",\"channel_after_trial\":\"/무료 체험 이후\",\"channel_alt_payment_body\":\"무료체험 기간에는 결제되지 않습니다. 채널을 가입하고 프리미엄 콘텐츠를 즐기세요.\",\"channel_alt_payment_body_02\":\"언제든지 취소가 가능합니다. 채널을 가입하고 프리미엄 콘텐츠를 즐기세요.\",\"channel_alt_payment_cta\":\"웹에서 무료체험 시작하기\",\"channel_alt_payment_cta_subsctibe\":\"웹에서 채널 가입 시작하기\",\"channel_badge_my\":\"내 패스\",\"channel_badge_normal\":\"채널 +\",\"channel_badge_subscriptionfee\":\"가입 요금\",\"channel_badge_text\":\"채널\",\"channel_balance_body\":\"잔액이 부톡하여 결제를 진행할 수 없습니다. 결제 방법을 변경하거나 거래 은행에서 문제를 해결해주세요.\",\"channel_balance_header\":\"잔액 부족으로 결제 실패\",\"channel_cancel_failed_snackbar\":\"가입 해지에 실패했습니다. 나중에 다시 시도해주세요\",\"channel_cancel_reason_01\":\"실수로 가입\",\"channel_cancel_reason_02\":\"단순 변심\",\"channel_cancel_reason_03\":\"높은 가격\",\"channel_cancel_reason_04\":\"관심있는 콘텐츠가 없음\",\"channel_cancel_reason_05\":\"비디오 에러로 인해 시청 불가\",\"channel_canceled_snackbar\":\"가입이 해지되었습니다. 앞으로 더 좋은 콘텐츠를 제공하기 위해 노력하겠습니다!\",\"channel_cardlimit_body\":\"카드 한도 초과로 인해 결제를 진행할 수 없습니다. 결제 방법을 변경하거나 카드사에서 문제를 해결해주세요.\",\"channel_cardlimit_header\":\"카드 한도 초과로 결제 실패\",\"channel_cdp_subtext_free_trial\":\"{{0}}일 무료체험\",\"channel_change_payment_body\":\"모바일 웹 브라우저에서 결제 방법을 변경할 수 있습니다.\",\"channel_change_payment_body_alt\":\"일부 기능은 모바일에서 사용할 수 없습니다. 결제 수단은 coupangplay.com/buy/mobile/channel/payment-edit에서 변경 가능합니다.\",\"channel_change_payment_failed\":\"결제 방법을 변경에 실패했습니다. 다시 시도해 주세요.\",\"channel_change_payment_succeed\":\"결제 방법을 성공적으로 변경했습니다.\",\"channel_comingsoon_title\":\"{{0}}월에 Coming Soon!\",\"channel_confirmation_agree_cta\":\"동의하고 진행하기\",\"channel_contents_day\":\"일\",\"channel_contents_days\":\"{{0}}일\",\"channel_contents_month\":\"{{0}}개월\",\"channel_contents_number\":\"콘텐츠 {{0}}개\",\"channel_copy_completed\":\"성공적으로 복사되었습니다!\",\"channel_cta_paynow\":\"지금 결제하기\",\"channel_cta_return_to_app\":\"앱으로 돌아가기\",\"channel_data_fail\":\"채널 정보를 불러오지 못했습니다\",\"channel_data_fail_recall\":\"다시 불러오기\",\"channel_error_failed_loading\":\"오류로 인해 화면을 불러들이지 못했습니다.\\\\n다시 시도해주세요,\",\"channel_error_refresh\":\"요청을 완료하지 못했습니다.\\\\n새로고침 해주세요.\",\"channel_error_subscribed_body\":\"이미 이 채널을 가입중입니다. 다시 확인해주세요.\",\"channel_error_subscribed_header\":\"이미 가입중인 채널\",\"channel_failed_popup_body\":\"결제 수단의 이상으로 결제 처리가 불가능합니다. 결제 방법을 변경하거나 다시 시도해 주십시오.\",\"channel_failed_popup_header\":\"결제 처리 불가능\",\"channel_free_trial\":\"7일 무료 체험\",\"channel_free_trial_alt\":\"{{0}}일 무료체험\",\"channel_free_trial_second_typeb\":\"이후 결제 \",\"channel_free_trial_typeb\":\"%1$s일 무료체험\",\"channel_general_error_popup\":\"사용에 불편을 끼쳐드려 죄송합니다. 에러가 발생하여 진행이 불가합니다. 잠시 후 다시 시도해주세요.\",\"channel_hero_CTA_no_freetrial\":\"채널 가입하기\",\"channel_hero_cta\":\"둘러보기\",\"channel_history_subscribed_badge\":\"내 패스\",\"channel_hovercard_freetrial\":\"채널 무료 체험하기\",\"channel_hovercard_price\":\"{{0}}에 {{1}} 채널 가입하기\",\"channel_info_text_1\":\"매달 새롭게 업데이트되는\",\"channel_info_text_2\":\"약 {{0}}여개 이상\",\"channel_info_text_3\":\"의 콘텐츠를 즐겨보세요.\",\"channel_multirail_last_text\":\"채널이 계속\\\\n추가 될 예정입니다.\",\"channel_multirail_title_number\":\"총 {{0}}편\",\"channel_next_payment\":\"다음 결제일  {{0}}\",\"channel_nonwow_body\":\"채널 가입은 와우 회원에게만 제공됩니다. 와우 회원에 가입하여 다양한 콘텐츠를 시청하세요!\",\"channel_nonwow_cta\":\"와우 회원 가입\",\"channel_nonwow_header\":\"채널 가입 실패\",\"channel_notice_body_01\":\"채널 이용료 결제 후 채널 콘텐츠를 시청하지 않은 경우에는 7일 내 청약철회가 가능합니다.\",\"channel_notice_body_02\":\"채널 콘텐츠 이용은 와우 멤버십 회원 계정에서만 가능합니다.\",\"channel_notice_body_03\":\"결제 실패 시 타 쿠페이 결제수단이 이용될 수 있습니다.\",\"channel_notice_header\":\"이건 꼭 알아두세요!\",\"channel_pay_monthly\":\"1개월 마다 결제\",\"channel_pay_quarterly\":\"3개월 마다 결제\",\"channel_pay_yearly\":\"1년 마다 결제\",\"channel_payment_complete\":\"결제가 완료되었습니다. 이제 채널을 즐길 수 있습니다!\",\"channel_payment_fail_body\":\"현재 결제를 사용할 수 없습니다. 쿠페이에서 결제 문제를 해결한 후 다시 시도하십시오.\",\"channel_payment_fail_header\":\"채널 결제 실패\",\"channel_payment_failed\":\"결제에 실패했습니다. 문제를 해결 후 다시 시도해주세요.\",\"channel_payment_update_cta\":\"결제 수단 업데이트하기\",\"channel_plans_aos_cta_subscribe\":\"채널 가입\",\"channel_plans_aos_cta_trial\":\"무료 체험 시작\",\"channel_plans_header_SVOD\":\"%1$s 채널을 결제하고 최신 에피소드와 다양한 콘텐츠들을 시청하세요\",\"channel_plans_subtext_aos_freetrial\":\"무료 체험 기간에는 결제되지 않습니다.\",\"channel_plans_subtext_aos_subscribe\":\"언제든지 취소가 가능합니다\",\"channel_plans_subtext_ios\":\"죄송합니다. iOS 앱에서는 가입이 지원되지 않습니다\",\"channel_popup_bank_check_body\":\"결제 서비스 시간이 아닙니다. (카드사, 은행 점검) 잠시 후 다시 시도하여 주십시오.\",\"channel_popup_bank_check_header\":\"카드사, 은행 점검 시간\",\"channel_precaution_body\":\"[중요] 본 유료서비스는 와우 멤버십 서비스 회원만을 대상으로 제공되는 것으로, 이용자가 와우 멤버십 서비스를 탈퇴하거나, 기타 사유로 와우 멤버십 서비스가 중단 또는 해지되는 경우에는 구매한 유료서비스의 이용기간이 남아있는 경우에도 더 이상 본 유료서비스를 이용할 수 없습니다.\\\\n무료 체험 기간이 제공되는 경우 무료 체험 기간 종료 시점에 유료로 전환되며 유료 전환 시점에 서비스 이용금액 결제가 청구됩니다.\\\\n본 유료서비스는 정기적 자동 결제 상품이며 서비스 이용금액은 변경될 수 있습니다.\\\\n유료서비스 이용금액은 매달 동일한 날짜에 자동 결제되며, 해당 월에 동일한 날짜가 없으면 말일에 결제됩니다.\\\\n본 유료서비스 구매 시 각 상품에서 정하는 범위 내에서 자유롭게 콘텐츠 시청이 가능하지만, 콘텐츠 제작자 또는 저작권자의 요청으로 일부 콘텐츠의 시청이 제한될 수 있습니다.\\\\n채널 내 개별 콘텐츠의 구성은 수시로 변경될 수 있습니다. \\\\n콘텐츠에 따라 원작 언어 자막은 제공되지 않을 수 있으며, 이는 환불 사유가 아닙니다.\\\\n본 유료서비스는 다음 결제일 전일까지 계약을 해지할 수 있습니다. 단, 유료서비스 이용금액 결제 후 이용기간 동안 유료서비스에서 제공되는 콘텐츠의 재생을 시작하지 않은 경우에 한하여 환불됩니다. 자세한 사항은 ‘쿠팡플레이 유료서비스 이용약관’을 참고하여 주시기 바랍니다.\\\\n결제 요금은 부가세(VAT)가 포함된 가격입니다. \\\\n쿠팡플레이 서비스는 국내에서 이용하실 수 있습니다. \\\\n다운로드는 지원되지 않습니다. \\\\niOS 최소사양 13 버전 이상 / 안드로이드 최소사양 6.0 (마시멜로) 버전 이상 / 스마트 TV 1.10.0 버전 이상 \\\\n환불 사유에 해당하는 경우 환불은 접수일로부터 3영업일 이내 결제 수단과 동일한 방법으로 처리되며 환불 지연 시 지연기간에 대한 법정 지연이자를 지급합니다(다만, 결제수단 관련업체의 사정으로 인해 처리기간에 차이가 있을 수 있습니다).\\\\n미성년자가 법정대리인의 동의 없이 결제한 경우 미성년자 또는 법정대리인이 결제를 취소할 수 있습니다.  \\\\n해지 신청: 내 패스 \\u003e 패스 별 우측상단 \\u003e 패스 해지\",\"channel_precaution_header\":\"[채널 가입 신청 유의사항 및 이용안내]\",\"channel_premium_cdp_logotext\":\"채널 %1$s 무료 체험으로 최신 에피소드 시청하기\",\"channel_premium_cdp_logotext_2\":\"채널 가입으로 최신 에피소드 시청하기\",\"channel_premium_purchase_title\":\"%1$s 채널을 결제하고 최신 에피소드와 다양한 콘텐츠들을 시청하세요\",\"channel_rail_blur_text\":\"더 많은 {{0}}를 보고 싶다면\\\\n{{1}} 채널에 가입해 보세요\",\"channel_refund_completed\":\"환불 완료\",\"channel_refund_inprogress\":\"환불 진행 중\",\"channel_refund_request\":\"환불 요청 접수\",\"channel_refund_request_snackbar\":\"환불이 완료되었습니다. 더 좋은 콘텐츠로 다시 만나요!\",\"channel_resolve_payment_body\":\"모바일 웹 브라우저에서 결제 문제를 해결할 수 있습니다.\",\"channel_resolve_payment_body_alt\":\"일부 기능은 모바일에서 사용할 수 없습니다. 결제 문제는 coupangplay.com/buy/mobile/channel/payment-edit에서 해결해주세요.\",\"channel_section_btn_text\":\"둘러보기\",\"channel_section_subtitle\":\"{{0}} 등 {{1}}개의 콘텐츠를 무제한으로 시청\",\"channel_section_title\":\"채널 가입\",\"channel_share_title\":\"{{0}}채널 {{1}}\",\"channel_subscription_complete\":\"{{0}} 채널 가입 완료!\",\"channel_subscription_expire\":\"만료 예정\",\"channel_subscription_free_trial\":\"{{0}} 무료체험\",\"channel_subscription_months\":\"{{0}}개월\",\"channel_subscription_payment_cycle\":\"{{0}} 마다 결제 {{1}}\",\"channel_subscription_payment_cycle_a\":\"무료체험 이후 {{0}} 마다 결제\",\"channel_subscription_payment_cycle_copy\":\"{{0}} 무료체험 이후 결제\",\"channel_subscription_payment_day\":\"일\",\"channel_subscription_payment_month\":\"월\",\"channel_subscription_payment_won\":\"원\",\"channel_subtext\":\"내 패스\",\"channel_subtext_free_trial\":\"{{0}}일 무료체험\",\"channel_subtext_free_trial_expired\":\"패스에 포함\",\"channel_summary_billing_date\":\"{{0}} 에 결제 예정\",\"channel_summary_billing_date_monthly\":\"(매달 {{0}}에 청구)\",\"channel_summary_billing_date_quarterly\":\"(3개월마다 매 분기 {{0}}에 청구)\",\"channel_summary_error_code\":\"위의 결제 수단으로 결제가 불가능합니다\",\"channel_summary_freetrial_cta\":\"무료체험 시작\",\"channel_welcome\":\"{{0}}채널 가입을 환영합니다!\",\"channel_welcome_cta\":\"채널 시작\",\"channel_welcome_message\":\"환영합니다! 채널 가입에 성공했습니다. 콘텐츠를 즐기세요.\",\"channel_x_popup_subcta\":\"%1$s 채널 둘러보기\",\"chat_filtered_word_toast\":\"부적절한 단어가 있습니다. 메시지 내용을 확인해주세요.\",\"chat_freeze_channel_error_toast\":\"비활성화된 채널입니다. 잠시 후 재시도해주세요.\",\"chat_generic_error_toast\":\"잠시 후 재시도 해주세요.\",\"chat_hint_connecting\":\"연결 중...\",\"chat_hint_text\":\"메시지를 입력하세요\",\"chat_hint_text_with_name\":\"{{name}}님으로 채팅하기\",\"chat_live_end_toast\":\"생방송이 종료되었습니다.\",\"chat_live_timemachine_end_toast\":\"라이브 채팅이 종료되었습니다.\",\"chat_live_timemachine_end_tooltip\":\"채팅이 종료되었습니다.\",\"chat_mute_warning_toast\":\"한번에 너무 많은 메시지를 보내면 채팅 사용이 제한될 수 있습니다.\",\"chat_muted_toast\":\"정책 위반으로 채팅 사용이 제한됩니다. 의도하지 않은 위반인 경우 고객센터로 문의해주세요.\",\"chat_panel_header\":\"실시간 채팅\",\"chat_rate_limit_toast\":\"채팅 입장 대기가 많으니 잠시 후 재시도해주세요.\",\"chat_report_confirm_toast\":\"신고가 완료되었습니다.\",\"chat_toast_error\":\"메시지를 보낼 수 없습니다. 다시 보내주세요.\",\"check_sports_alarm_popup\":\"밤 9시 이후에는 알림끄기\",\"choose_env\":\"환경 선택\",\"chromecast_failure_wifi_body\":\"와이파이에 연결 한 후 다시 시도해주세요.\",\"chromecast_failure_wifi_title\":\"캐스팅할 수 없습니다.\",\"code_applied_header\":\"선예매 코드 입력 완료\",\"code_applied_successful\":\"선예매 코드가 성공적으로 적용되었습니다.\",\"code_apply_cta\":\"적용하기\",\"code_body1\":\"\\u003chighlight\\u003e현재 앱에 로그인된 이름은 {{0}}\\u003c/highlight\\u003e 입니다.\",\"code_body2\":\"코드 입력 후 변경이나 재입력이 불가하며, 본인 인증이 완료된 이름으로 진행하시기 바랍니다. 입력 후 철회가 불가능합니다.\",\"code_body3\":\"*가족 계정 구매자는 공연 당일 직계존속 증빙 서류 '원본' 필참\",\"code_header\":\"선예매 코드 입력\",\"code_input_guide\":\"6자 코드를 입력해주세요.\",\"code_input_guidetext\":\"코드를 입력해주세요\",\"code_registered_successful\":\"성공적으로 코드가 입력되었습니다.\",\"code_reminder\":\"팬클럽 회원들을 위한 선예매 코드 등록으로, 지금 등록시 \\u003chighlight\\u003e티켓 예매 당일 더욱 신속하게 구매\\u003c/highlight\\u003e하실 수 있습니다.\",\"coldplay_banner_description\":\"콜드플레이와의 특별한 온라인 팬미팅\",\"coldplay_banner_title\":\"응모하기\",\"coldplay_cta_2\":\"이미 응모하셨습니다\",\"coldplay_cta_3\":\"이벤트 종료\",\"coldplay_popup_body\":\"당첨자는 11월 29일(월)\\\\n이메일과 문자로 개별 공지됩니다.\",\"coldplay_popup_cta\":\"콘서트 페이지로 돌아가기\",\"coldplay_popup_header\":\"이벤트 응모가 완료되었습니다!\",\"coldplay_share_copiedlink\":\"링크가 복사되었습니다!\",\"coldplay_share_cta\":\"이벤트 공유하기\",\"coldplay_webview_checkbox\":\"(필수) 개인 정보 수집 동의\",\"coldplay_webview_disclaimer\":\"[개인정보 수집 및 이용 동의]\\\\n1. 개인정보 수집 항목: 이름, 전화번호, SNS주소\\\\n2.개인정보 수집 및 이용 목적: 콜드플레이와의 온라인 미팅 및\\u000b앨범 당첨자 선정, 이벤트 진행에 대한 커뮤니케이션\\\\n3. 개인정보 보유 및 이용 기간: \\u003cb\\u003e이벤트 종료 영업일 5 후 파기\\u003c/b\\u003e\\\\n4. 동의를 거부할 수 있으나, 동의 거부 시 이벤트 참여가 제한 됩니다.\",\"coldplay_webview_draw_submit\":\"이벤트 응모하기\",\"coldplay_webview_example1\":\"(예. 김쿠팡)\",\"coldplay_webview_example2\":\"(예. 01012345678)\",\"coldplay_webview_example3\":\"(예. www.instagram.com/xxx)\",\"coldplay_webview_example4\":\"(단체 관람 선호 지역 서울/부산 중 택1)\",\"coldplay_webview_guide1\":\"맨 위의 포스터 이미지가 잘 보이도록 캡쳐한다\",\"coldplay_webview_guide2\":\"SNS에 캡쳐한 포스터를 아래 해시태그와\\\\n함께 게재한다\",\"coldplay_webview_guide2a\":\"*여러분의 WOW함을 보여주세요!\\\\n원본 포스터만 올려도 OK!\\\\n포스터 팬아트, 포스터처럼 사진 찍기 등\\\\n나만의 창작물을 올리면 당첨 확률 UP!\",\"coldplay_webview_guide3\":\"아래 정보 작성 후 이벤트 응모 완료!\",\"coldplay_webview_hashtag\":\"#쿠팡플레이콘서트 #쿠플콘 #콜드플레이 #쿠팡플레이 #LetsPlay캠페인\",\"coldplay_webview_header1\":\"응모 방법\",\"coldplay_webview_header2\":\"혜택\",\"coldplay_webview_header3\":\"당첨자는 11월 29일(월)\\\\n이메일과 문자로 개별 공지됩니다.\",\"coldplay_webview_info1\":\"이름\",\"coldplay_webview_info2\":\"연락처\",\"coldplay_webview_info3\":\"SNS 링크\",\"coldplay_webview_info4\":\"선호 지역\",\"coldplay_webview_name\":\"쿠팡플레이 콘서트: 콜드플레이\",\"coldplay_webview_prize1\":\"콘서트 종료 후\\\\n12월 5일 (일) 새벽\\\\n콜드플레이와의 온라인 팬미팅\",\"coldplay_webview_prize2\":\"영화관에서 함께 보는\\\\n쿠팡플레이 콘서트\\\\n*세부 사항 변동 가능\",\"coldplay_webview_prize3\":\"콜드플레이\\\\n\\\"Music of the Spheres\\\"\\\\n앨범 증정\",\"coldplay_webview_subheader1\":\"30명\",\"coldplay_webview_subheader2\":\"서울/부산 각 200명\",\"coldplay_webview_subheader3\":\"50명\",\"coldplay_webview_subtitle\":\"이벤트 기간: 11월 19일 (금) - 11월 26일 (금)\",\"coldplay_webview_title\":\"회원들을 위한 특별한 이벤트\\\\nLet's Play, Coldplay!\",\"coldplay_webview_warning\":\"[이벤트 유의사항]\\\\n- 이벤트 상품은 당첨 발표 후 취합된 개인정보를 기반으로 발송되며, 부적절한 개인정보에 따른 상품 미수령 및 반송 시 당사는 재발송의 의무를 가지지 않습니다.\\\\n- 개인정보(이름, 연락처, ID)는 주소 확인과 추후 경품 배송을 위해 대행사에 위탁 처리되며 경품 발송 후 파기됩니다. 경품 배송 관련하여 위 수탁업체에서 작성해주신 연락처로 연락을 취할 수 있습니다.\\\\n- 이벤트 진행 시간을 고려하여 14세 미만 청소년은 온라인 팬미팅과 함께 보는 콘서트 당첨에서 제외됩니다.\\\\n- 이벤트는 쿠팡 와우에 가입된 한 계정 당 한 번만 응모 가능합니다.\",\"coldplay_webview_winner_subtext\":\"*11월 29일까지 SNS에 유지된 게시글에 한 해 선정\",\"collection_watch_now\":\"재생하기!\",\"coming_soon\":\"공개 예정\",\"commerce_vote_webview_error_header\":\"인증 필요\",\"commerce_vote_webview_error_popup\":\"번호 미인증 계정이거나 이미 해당 연락처로 투표가 완료되었습니다. 공정한 투표를 위해 마이쿠팡\\u003e이름 클릭\\u003e회원정보 수정\\u003e성명 수정 클릭 또는 휴대폰 번호 수정 클릭하여 인증 후 재시도해주세요.\\\\n*인증 완료 후에도 해당 메시지가 보인다면 10초 후 재시도해주세요.\",\"common_cancel\":\"취소\",\"common_date_format\":\"yyyy년 MM월 dd일\",\"common_exit\":\"나가기\",\"common_maybe_later\":\"나중에 가입하기\",\"common_okay\":\"확인\",\"common_text_bullet\":\"•\",\"connect_new_device_nonwow_unavailable\":\"일반 회원을 위한 쿠팡플레이 TV 경험은 준비 중입니다. 와우회원이 되면, TV로 시청할 수 있습니다.\",\"connected_to_airplay\":\"AirPlay 이용중\",\"consent_android_tv_title\":\"쿠팡플레이 이용약관 및 개인정보 동의에 대한 동의\",\"consent_feedback_agree_collection_daytime\":\"{{0}}에 마케팅 목적의 개인정보 수집 및 이용, 광고성 앱 푸시 수신에 동의했습니다: 주간 동의\",\"consent_feedback_agree_collection_daytime_nighttime\":\"{{0}}에 마케팅 목적의 개인정보 수집 및 이용, 광고성 앱 푸시 수신에 동의했습니다: 주간 동의, 야간 동의\",\"consent_feedback_agree_collection_nighttime\":\"{{0}}에 마케팅 목적의 개인정보 수집 및 이용, 광고성 앱 푸시 수신에 동의했습니다: 야간 동의\",\"consent_feedback_agree_collection_only\":\"{{0}}에 마케팅 목적의 개인정보 수집 및 이용에 동의했습니다\",\"consent_feedback_agree_daytime\":\"{{0}}에 광고성 앱 푸시 수신에 동의했습니다: 주간 동의, 야간 거부\",\"consent_feedback_agree_daytime_nighttime\":\"{{0}}에 광고성 앱 푸시 수신에 동의했습니다: 주간 동의, 야간 동의\",\"consent_feedback_agree_daytime_only\":\"{{0}}에 광고성 앱 푸시 수신에 동의했습니다: 주간 동의\",\"consent_feedback_agree_general\":\"{{0}} 쿠팡플레이 마케팅 앱 푸시 수신 동의 처리 완료\",\"consent_feedback_agree_nighttime\":\"{{0}}에 광고성 앱 푸시 수신에 동의했습니다: 주간 거부, 야간 동의\",\"consent_feedback_agree_nighttime_only\":\"{{0}}에 광고성 앱 푸시 수신에 동의했습니다: 야간 동의\",\"consent_feedback_disagree_col