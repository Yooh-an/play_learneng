            "text": "{\"data\":{\"id\":\"MLRedis\",\"data\":[{\"id\":\"a7d773e1-d241-4e56-9c5e-83fbb2faac93\",\"parent_id\":null,\"title\":\"빅뱅이론\",\"description\":\"괴짜인 네명의 과학도와 금발 미녀의 이야기를 그린 코믹 시트콤\",\"short_description\":\"사회성 부족하고 철없는 공대남들의\\n예측 불가능 코미디 드라마\",\"as\":\"TVSHOW\",\"region\":\"KR\",\"languages\":[\"영어\",\"한국어\"],\"audios\":[\"영어\"],\"age_rating\":\"15+\",\"age_rating_localized\":\"15+\",\"is_rating_category_exempted\":false,\"streamable\":true,\"downloadable\":false,\"running_time\":1380,\"images\":{\"title-card\":{\"id\":\"526664b5-c072-4b86-be79-fe208fba5371\",\"md5\":null,\"url\":\"https://img.coupangstreaming.com/titles/a7d773e1-d241-4e56-9c5e-83fbb2faac93/title-card/01b4322e-c100-44da-94c7-6533187777e7.jpeg\",\"tags\":\"\",\"index\":null,\"default\":false,\"language\":\"ko\",\"title_id\":\"a7d773e1-d241-4e56-9c5e-83fbb2faac93\",\"created_at\":\"2023-09-26T15:34:34.704+00:00\",\"updated_at\":\"2025-01-15T07:45:09.321+00:00\"},\"background\":{\"id\":\"d1d15b6e-cbd2-4569-9d06-d03b4cf2329b\",\"md5\":null,\"url\":\"https://img.coupangstreaming.com/titles/a7d773e1-d241-4e56-9c5e-83fbb2faac93/background/6a4022c9-b410-42b6-b3f1-b9afffe5ca4a.jpeg\",\"tags\":\"\",\"index\":null,\"default\":false,\"language\":\"ko\",\"title_id\":\"a7d773e1-d241-4e56-9c5e-83fbb2faac93\",\"created_at\":\"2022-06-15T04:27:37.836+00:00\",\"updated_at\":null},\"hero\":{\"id\":\"7a32aa3b-3eee-4066-b26d-7dce7a9318c5\",\"md5\":null,\"url\":\"https://img.coupangstreaming.com/titles/a7d773e1-d241-4e56-9c5e-83fbb2faac93/hero/1abee134-c779-43c2-9db0-6169b0e487ea.jpeg\",\"tags\":\"\",\"index\":null,\"default\":false,\"language\":\"ko\",\"title_id\":\"a7d773e1-d241-4e56-9c5e-83fbb2faac93\",\"created_at\":\"2022-06-15T04:31:37.522+00:00\",\"updated_at\":null},\"hero-largescreen\":{\"id\":\"e74078e1-ddb0-4ab7-8594-42465184be85\",\"md5\":null,\"url\":\"https://img.coupangstreaming.com/titles/a7d773e1-d241-4e56-9c5e-83fbb2faac93/hero-largescreen/302afde5-3c93-4448-9a47-434db9b7a6fc.jpeg\"