ublished_at\":\"2022-08-26T09:08:21.530Z\",\"expires_on\":\"2030-08-30T09:08:28.462Z\",\"created_at\":\"2022-08-26T09:08:51.615Z\",\"updated_at\":\"2023-11-06T12:21:21.109Z\",\"running_time_friendly\":\"1분\",\"running_time\":57,\"title_canonical\":\"빅뱅이론\",\"type\":\"TRAILER\",\"enable_view_count\":false,\"view_count\":0,\"published_on\":\"COSMOS\"}},\"playState\":\"WATCHNOW\",\"bestReviews\":[{\"id\":\"e5af43ba-5789-469b-86c5-006eec3e0b9a\",\"review\":\"빅뱅을 들여오다니.. 그것도 번역 새로 해서.. 쿠플 인정\",\"meta\":\"566명이 추천한 리뷰\"},{\"id\":\"b9f7f929-1db4-4f57-8951-77bdb6a568dc\",\"review\":\"난 넷플에서 마지막시즌까지 5리턴뷰함 그러나 쿠플에 뜨고 다시 시작 ㅎㅎㅎ 내생애 최고의 시트콤\",\"meta\":\"101명이 추천한 리뷰\"},{\"id\":\"4dc30f66-4b39-4898-ade6-6eaf2720d7cd\",\"review\":\"넷플에서 사라져서 아쉬웠는데 다시 정주행\",\"meta\":\"77명이 추천한 리뷰\"}],\"social\":\"\",\"stringFormats\":{\"season\":{\"all\":\"전체 시즌\",\"one\":\"시즌 %d\",\"range\":\"시즌 %d ~ %d\",\"oneBrief\":\"시즌 %d\"},\"episode\":{\"all\":\"전체 회차\",\"one\":\"%d화\",\"range\":\"%d ~ %d화\",\"oneBrief\":\"%d화\"}},\"running_time_friendly\":\"23분\",\"subType\":\"DEFAULT\"},{\"id\":\"65c0c0a9-c2eb-4016-ab42-e26f0426fdb6\",\"parent_id\":null,\"title\":\"프렌즈\",\"description\":\"모든 가능성이 열려 있는 도시 뉴욕. 이곳에 여섯 명의 청춘들이 있다. 다이내믹 한 일상도 어디로 튈지 모르는 내 인생도 친구들과 함께라면 걱정 없다. 어떤 일이 벌어지든 함께 일 테니. 오늘도 카페에 모여 앉아있는 친구들. 잠깐, 또 무슨 일이 벌어질 것 같은데.\",\"short_description\":\"알쏭달쏭 꼬여만 가는\\n뉴욕 청춘들의 풋풋한 우정과 사랑\",\"as\":\"TVSHOW\",\"region\":\"KR\",\"languages\":[\"영어\",\"한국어\"],\"audios\":[\"영어\"],\"age_rating\":\"15+\",\"age_rating_localized\":\"15+\",\"is_rating_category_exempted\":false,\"streamable\":true,\"downloadable\":false,\"running_time\":1380,\"images\":{\"background\":{\"id\":\"1122629b-5670-4b37-a0f4-c1b10ab0d4ff\",\"md5\":null,\"url\":\"https://img.coupangstreaming.com/titles/65c0c0a9-c2eb-4016-ab42-e26f0426fdb6/background/b891ed69-c40f-4411-84c4-b374a6592292.jpeg\",\"tags\":\"\",\"index\":null,\"default\":false,\"language\":\"ko\",\"title_id\":\"65c0c0a9-c2eb-4016-ab42-e26f0426fdb6\",\"created_at\":\"2022-03