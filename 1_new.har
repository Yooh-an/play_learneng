            "text": "{\"data\":[{\"id\":\"1ea8242b-b5de-4bca-a325-2fdf7371a558\",\"parent_id\":\"cc9e3a09-49d1-4608-ba7e-6ece3d8d577c\",\"title\":\"1. 오피스: 미국의 직장\",\"description\":\"마이클은 인원 감축 소식을 비밀로 하며 직원들을 지키려고 하지만, 결국 소식을 들은 직원들은 더 불안해진다.\",\"short_description\":\"마이클은 인원 감축 소식을 비밀로 하며 직원들을 지키려고 하지만, 결국 소식을 들은 직원들은 더 불안해진다.\",\"as\":\"EPISODE\",\"region\":\"KR\",\"languages\":[\"영어\",\"한국어\"],\"audios\":[],\"audio\":\"en\",\"age_rating\":\"15+\",\"age_rating_localized\":\"15+\",\"is_rating_category_exempted\":false,\"streamable\":true,\"downloadable\":true,\"running_time\":1383,\"images\":{\"story-art\":{\"id\":\"62c435d5-9492-490f-a546-51bbba06c5a5\",\"url\":\"https://img.coupangstreaming.com/titles/1ea8242b-b5de-4bca-a325-2fdf7371a558/story-art/9ef8e738-7d7e-4535-8a56-cd700af7809d.jpg\",\"tags\":\"automated\",\"index\":0,\"language\":\"ko\",\"title_id\":\"1ea8242b-b5de-4bca-a325-2fdf7371a558\",\"created_at\":\"2022-11-22T04:22:48.193Z\",\"updated_at\":\"2022-11-22T04:22:48.356Z\"}},\"tags\":[{\"tag\":\"코미디\",\"meta\":{\"genre\":true},\"label\":\"코미디\",\"language\":\"ko\"},{\"tag\":\"시트콤\",\"meta\":{\"genre\":true},\"label\":\"시트콤\",\"language\":\"ko\"},{\"tag\":\"drama\",\"meta\":{\"genre\":true},\"label\":\"드라마\",\"language\":\"ko\"}],\"people\":[{\"name\":\"스티브 카렐\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"레인 윌슨\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"존 크래신스키\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"제나 피셔\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"비제이 노박\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"브라이언 바움가트너\",\"role\":\"CAST\",\"language\":\"ko\"},{\"name\":\"켄 콰피스\",\"role\":\"DIRECTOR\",\"language\":\"ko\"}],\"meta\":{\"awards\":[],\"copyright\":\"© 2005 NBC Studios, Inc. and Universal Network Television LLC. All Rights Reserved.\",\"releaseYear\":2004,\"rating_levels\":{\"drugs\":\"none\",\"theme\":\"none\",\"horror\":\"none\",\"language\":\"none\",\"violence\":\"none\",\"sex_and_nudity\":\"none\",\"